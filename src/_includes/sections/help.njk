<section class="help pd" id="help">
  <div class="container">
    <span class="section-tag">{{ t.help.tag }}</span>
    <h2 class="section-title">{{ t.help.title }}</h2>
    <p class="section-description">{{ t.help.description }}</p>

    <div class="help-grid">
      {% set icons = [
        'assets/img/icon-heart.svg',
        'assets/img/icon-voluntario.svg',
        'assets/img/icon-doacao.svg',
        'assets/img/icon-calendario.svg'
      ] %}
      {% for card in t.help.cards %}
      <div class="help-card {% if card.highlight %}destaque{% endif %}">
        <div class="icon">
          <img src="../{{ icons[loop.index0] }}" alt="{{ card.iconAlt }}" />
        </div>
        <h3>{{ card.title }}</h3>
        <p>{{ card.description }}</p>

        {% if card.type == 'modal' %}
        <button
          type="button"
          class="{% if card.highlight %}btn-white{% else %}btn-red{% endif %} btn-open-modal"
          data-file="../assets/data/modals/{{ locale }}/{{ card.modal }}.html"
        >
          {{ card.button }}
        </button>
        {% else %}
        <a href="#" class="btn-red scroll-link" data-target="{{ card.target }}">
          {{ card.button }}
        </a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
